#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "stringio"

begin
  root = File.expand_path("../..", __dir__)
  Dir.chdir(root)
  gemfile = File.join(root, "Gemfile")
  ENV["BUNDLE_GEMFILE"] = gemfile
  raise LoadError, "project Gemfile is missing" unless File.file?(gemfile)

  original_stdout, original_stderr = $stdout, $stderr
  $stdout = $stderr = StringIO.new
  begin
    require "bundler"
    Bundler.setup
  ensure
    $stdout, $stderr = original_stdout, original_stderr
  end
  require "quality_gate"
  require "quality_gate/codex_stop_hook"
  input = JSON.parse(STDIN.read)
  puts JSON.generate(QualityGate::CodexStopHook.new(dir: root).call(input))
rescue StandardError, LoadError => error
  puts JSON.generate("systemMessage" => "Quality Gate verification unavailable (#{error.class}); check the project bundle and run `bundle exec quality_gate verify --format json` manually.")
end
