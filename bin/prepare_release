#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "rbconfig"
require "rubygems/package"

# Validates and builds a local release artifact without publishing it.
class ReleasePreparer
  DEFAULT_RUNNER = ->(command, root) { system(*command, chdir: root) }
  DEFAULT_BUILDER = lambda do |root|
    Dir.chdir(root) do
      specification = Gem::Specification.load("quality_gate.gemspec")
      FileUtils.mkdir_p("pkg")
      Gem::Package.build(specification, false, false, File.join("pkg", specification.file_name))
    end
  end

  def initialize(root: File.expand_path("..", __dir__), ruby: RbConfig.ruby,
                 runner: DEFAULT_RUNNER, builder: DEFAULT_BUILDER, stderr: $stderr)
    @root = root
    @ruby = ruby
    @runner = runner
    @builder = builder
    @stderr = stderr
  end

  def call
    commands.each do |command|
      next if @runner.call(command, @root)

      @stderr.puts "Release preparation failed: #{command.join(" ")}"
      return false
    end
    return true if @builder.call(@root)

    @stderr.puts "Release preparation failed: build quality_gate.gemspec"
    false
  end

  private

  def commands
    [
      [@ruby, "-S", "bundle", "exec", "rake", "test"],
      [@ruby, "-S", "bundle", "exec", "rake", "rubocop"],
      [@ruby, File.join(@root, "bin", "generate_llm.rb")]
    ]
  end
end

exit(ReleasePreparer.new.call ? 0 : 1) if $PROGRAM_NAME == __FILE__
